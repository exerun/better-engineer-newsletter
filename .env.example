# PostgreSQL Database Environment Variables
# Copy this file to .env and fill in your actual values

# PostgreSQL Database Connection Settings
DB_HOST=your_database_host_here         # e.g., localhost, db.railway.app, or xyz.amazonaws.com
DB_NAME=your_database_name_here         # e.g., betterengineer, postgres
DB_USER=your_database_username_here     # e.g., postgres, admin
DB_PASS=your_database_password_here     # Your database password
DB_PORT=5432                           # PostgreSQL port (usually 5432)

# Example configurations for different providers:

# Railway.app
# DB_HOST=containers-us-west-xyz.railway.app
# DB_NAME=railway
# DB_USER=postgres
# DB_PASS=your_railway_password
# DB_PORT=5432

# Render.com
# DB_HOST=dpg-xyz-a.oregon-postgres.render.com
# DB_NAME=your_database_name
# DB_USER=your_username
# DB_PASS=your_render_password
# DB_PORT=5432

# Neon.tech
# DB_HOST=ep-xyz.us-east-1.aws.neon.tech
# DB_NAME=neondb
# DB_USER=your_username
# DB_PASS=your_neon_password
# DB_PORT=5432
